{
  "name": "indesign-nutria-mcp",
  "version": "1.4.2",
  "description": "The most comprehensive MCP server for Adobe InDesign — 197 tools, full DOM control, AI-native automation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "indesign-nutria-mcp": "./dist/index.js"
  },
  "homepage": "https://github.com/nutriandrea/adobe-indesign-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nutriandrea/adobe-indesign-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nutriandrea/adobe-indesign-mcp/issues"
  },
  "keywords": [
    "adobe",
    "indesign",
    "mcp",
    "model-context-protocol",
    "ai",
    "automation",
    "claude",
    "opencode",
    "extendscript",
    "uxp",
    "design-automation",
    "publishing",
    "print",
    "layout"
  ],
  "license": "MIT",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "lint": "eslint src scripts --ext .ts",
    "lint:fix": "eslint src scripts --ext .ts --fix",
    "verify:tool-counts": "tsx scripts/verify-tool-counts.ts",
    "docs:tools": "tsx scripts/generate-tool-docs.ts",
    "verify:docs": "tsx scripts/generate-tool-docs.ts --check",
    "verify:pack": "npm run build && node scripts/verify-pack.mjs",
    "verify": "npm run lint && npm run verify:tool-counts && npm run verify:docs && npm test",
    "smoke:macos": "node scripts/smoke-macos.mjs",
    "smoke:recipes": "node scripts/smoke-recipes.mjs",
    "prepublishOnly": "npm run verify && npm run verify:pack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.18.2",
    "uuid": "^9.0.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
